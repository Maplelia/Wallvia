node_modules/
*.log
.DS_Store

# Release artifacts are attached to GitHub releases, not committed
*.vsix
*.tgz
# Hash manifest for those assets: generated by scripts/checksums.mjs at release
# time and attached to the release; a committed copy would only go stale
SHA256SUMS.txt

# Local-only material — never publish
.secrets/
.npm-cache/
# Test scratch trees (every suite makes its own and removes it, but a crashed
# run leaves one behind).
tests/.tmp-*/
tools/.tmp-*/
# Screenshots the manual tools write next to themselves.
tools/.verify-window.png
tools/.state.png
# Stray screenshots / probes from one-off debugging sessions.
*.tmp-*.cjs
